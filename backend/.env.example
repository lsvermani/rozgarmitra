# ==============================
# Rozgarmitra Backend - Env Vars
# ==============================

# App
NODE_ENV=development
PORT=5000
# Reported by GET /api/health and shown on the app's Server / Admin Settings page.
APP_VERSION=1.0.0
# Set to true ONLY when running behind a reverse proxy / load balancer so
# req.ip and req.protocol use the forwarded values. Leave false when the Node
# process is directly reachable: trusting forwarded headers from arbitrary
# clients would let them spoof their address.
TRUST_PROXY=false

# Mode: "demo" enables mock OTP + relaxed limits. "production" requires real SMS provider.
APP_MODE=demo

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/rozgarmitra

# JWT
JWT_SECRET=change_this_super_secret_in_production
JWT_EXPIRES_IN=30d

# OTP
OTP_EXPIRY_MINUTES=5
# In demo mode, this fixed OTP is always accepted so you can demo without SMS.
DEMO_OTP=123456

# --- Future SMS provider config (not required in demo mode) ---
# SMS_PROVIDER=msg91|twilio|firebase
# MSG91_API_KEY=
# MSG91_SENDER_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# FIREBASE_PROJECT_ID=

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200

# Admin bootstrap (used by seed script)
ADMIN_MOBILE=9999999999
ADMIN_NAME=Super Admin

# CORS
CORS_ORIGIN=*

# Firebase Admin SDK service account JSON, kept as a single environment variable.
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}
