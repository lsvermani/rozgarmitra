# ==============================
# Rozgarmitra Backend - Env Vars
# ==============================

# App
NODE_ENV=development
PORT=5000
# Reported by GET /api/health and shown on the app's Server / Admin Settings page.
APP_VERSION=1.0.0
# Set to true ONLY when running behind a reverse proxy / load balancer so
# req.ip and req.protocol use the forwarded values. Leave false when the Node
# process is directly reachable: trusting forwarded headers from arbitrary
# clients would let them spoof their address.
TRUST_PROXY=false

# Mode: "demo" enables mock OTP + relaxed limits. "production" requires real SMS provider.
APP_MODE=demo

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/rozgarmitra

# JWT
JWT_SECRET=change_this_super_secret_in_production
JWT_EXPIRES_IN=30d

# OTP
OTP_EXPIRY_MINUTES=5
# In demo mode, this fixed OTP is always accepted so you can demo without SMS.
DEMO_OTP=123456

# --- Future SMS provider config (not required in demo mode) ---
# SMS_PROVIDER=msg91|twilio|firebase
# MSG91_API_KEY=
# MSG91_SENDER_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# FIREBASE_PROJECT_ID=

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200

# Admin password sign-in (see routes/authRoutes.js). The per-account lockout in
# services/adminAuthService.js is the hard limit; this is the broader per-IP
# throttle in front of it. Raise ADMIN_LOGIN_MAX_ATTEMPTS for shared/NAT'd
# office IPs, lower it for internet-facing deployments.
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_LOGIN_MAX_ATTEMPTS=20

# Admin bootstrap (used by seed script)
# Admin bootstrap (used by seed script).
# This creates the admin ACCOUNT. It is not the OTP allow-list - see
# ADMIN_PHONE_NUMBER in the Admin Panel OTP section below.
ADMIN_MOBILE=8699142699
ADMIN_NAME=Super Admin

# ===========================================================================
# Admin Panel OTP login  (/login -> Send OTP -> Verify OTP)
# ===========================================================================
# Endpoint reference:
#   POST /api/auth/request-otp   { "phone": "8699142699" }
#   POST /api/auth/verify-otp    { "phone": "8699142699", "otp": "123456" }
#
# The code is generated on the server with crypto.randomInt, stored ONLY as an
# HMAC-SHA256 digest, expires after 5 minutes, allows 5 attempts, is invalidated
# after use, and is replaced by the next request. It is never returned to the
# browser and never written to a log.
#
# --- The one authorised admin number ---
# The ONLY number permitted to complete an OTP admin sign-in. Any other number
# is refused with "Unauthorized phone number." before a code is generated, so
# the gateway is never called for it.
# Accepted formats: 8699142699 | +918699142699 | 91-86991-42699
ADMIN_PHONE_NUMBER=8699142699
ADMIN_OTP_ENABLED=true

# --- OTP policy ---
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# --- Abuse protection ---
# Per-number hourly cap, enforced in the database so a restart cannot reset it.
ADMIN_OTP_PER_PHONE_HOURLY_LIMIT=5
# Per-IP ceilings, enforced by express-rate-limit in routes/adminOtpRoutes.js.
ADMIN_OTP_PER_IP_HOURLY_LIMIT=20
ADMIN_OTP_VERIFY_MAX_ATTEMPTS=20

# --- HMAC pepper for hashing OTPs [GENERATED BY YOU] ---
# Without this, a stolen database dump could brute-force all 900,000 six-digit
# codes in under a second. Generate with: openssl rand -hex 32
# Rotating it invalidates every in-flight code (safe while none are outstanding).
ADMIN_OTP_PEPPER=

# --- SMS body ---
# {{OTP}} is substituted immediately before sending. The template never reaches
# the database and the rendered body is never logged.
ADMIN_OTP_MESSAGE_TEMPLATE=Your Admin Panel login OTP is: {{OTP}}. This OTP is valid for 5 minutes. Do not share this OTP with anyone.

# --- Development only ---
# Echoes the generated code in the request-otp response so the automated suite
# can finish a verification without a physical handset and SIM.
# REFUSED automatically when NODE_ENV=production.
ADMIN_OTP_TEST_MODE=false
ADMIN_NAME=Super Admin

# CORS
CORS_ORIGIN=*

# ===========================================================================
# SMS Gateway - Android phone + physical SIM as the OTP sender
# ===========================================================================
# The gateway makes OUTBOUND HTTPS requests only. No public IP, no port
# forwarding, nothing exposed on the phone.
#
#   OTP_PROVIDER=gateway   selects this transport
#
# --- OTP policy ---
OTP_ENABLED=true
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# --- Gateway switch ---
SMS_GATEWAY_ENABLED=true

# --- Gateway credentials ---
# SMS_GATEWAY_ID / SMS_GATEWAY_SECRET is the single-gateway style from the brief.
# Leave SECRET blank to use per-device tokens instead, which are the preferred
# option because rotating one does not take every gateway offline.
# Generate with: openssl rand -hex 32
SMS_GATEWAY_ID=gateway-001
SMS_GATEWAY_SECRET=

# The SIM inside the gateway phone. Displayed in the admin panel so you can
# confirm which SIM is in use; never used to route a message, and never treated
# as an OTP recipient.
SMS_GATEWAY_PHONE_NUMBER=+918699142699

# --- Cadence (milliseconds) ---
SMS_GATEWAY_POLL_INTERVAL=5000
SMS_GATEWAY_HEARTBEAT_INTERVAL=30000
# A claimed job with no result in this window becomes `unknown`, never requeued.
SMS_GATEWAY_JOB_TIMEOUT=60000

# --- SMS body ---
# {{OTP}} is substituted just before sending. If the placeholder is missing the
# code is appended rather than sending a message with no code in it.
OTP_MESSAGE_TEMPLATE=Your verification code is {{OTP}}. It is valid for 5 minutes. Do not share this code with anyone.

# ===========================================================================
# MSG91 server-side OTP API  (preferred over the widget below)
# ===========================================================================
# The authkey never leaves the backend - unlike the OTP Widget, which requires
# tokenAuth inside the browser or APK. MSG91 is used only to DELIVER the code;
# this application generates it and verifies it locally.
#
# MSG91_API_ENABLED=true
# MSG91_API_AUTHKEY=      [FROM MSG91] API authkey
# MSG91_API_TEMPLATE_ID=  [FROM MSG91] OTP template UUID (must contain {code})
# MSG91_API_SENDER=MSG91  sender id the recipient sees
MSG91_API_ENABLED=false
MSG91_API_AUTHKEY=
MSG91_API_TEMPLATE_ID=
MSG91_API_SENDER=MSG91

# ===========================================================================
# MSG91 OTP Widget
# ===========================================================================
# Client-side widget (exposeMethods). The widget generates and checks the code,
# then hands the client a JWT access-token which THIS BACKEND re-validates with
# MSG91's "Verify Access Token" endpoint before issuing a session.
#
# MSG91_ENABLED=true   master switch
# MSG91_WIDGET_ID=     [FROM MSG91] widget id from the MSG91 panel
# MSG91_TOKEN_AUTH=    [FROM MSG91] auth token - never commit it
# MSG91_OTP_LENGTH=6
# MSG91_RATE_WINDOW_MINUTES=15
# MSG91_RATE_MAX_REQUESTS=20
# Override only if MSG91 moves the endpoint; see docs/MSG91_OTP.md.
# MSG91_API_BASE_URL=https://control.msg91.com
# MSG91_VERIFY_TOKEN_PATH=/api/v5/otp/{widgetId}/verify/token
MSG91_ENABLED=false
MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=
MSG91_OTP_LENGTH=6
MSG91_RATE_WINDOW_MINUTES=15
MSG91_RATE_MAX_REQUESTS=20

# ===========================================================================
# OTP delivery provider
# ===========================================================================
# Which transport actually sends the code. The application always generates
# the code itself and verifies it locally, so switching provider is a one-line
# change and never alters the security model.
#
#   otpdev   - OTP.dev (multi-channel: sms / whatsapp / telegram / viber /
#              voice / email). Requires a paid account; see docs/OTP_DEV.md.
#   whatsapp - Meta WhatsApp Business Cloud API (see below).
#   demo     - nothing is delivered. Local development default.
OTP_PROVIDER=demo

# --- OTP.dev ---
# Get the API key and template id from your OTP.dev dashboard. The template must
# contain a {code} placeholder, otherwise every send fails with error 1624.
OTPDEV_API_KEY=
OTPDEV_TEMPLATE_ID=
OTPDEV_CHANNEL=sms
# The sender name users see. Must be registered/approved for some channels.
OTPDEV_SENDER=OTP.dev

# ===========================================================================
# WhatsApp Business Cloud API (Meta) - OTP delivery
# ===========================================================================
# Values marked [FROM META] must be copied from Meta Business Manager /
# WhatsApp Manager. Never commit real values: backend/.env is gitignored.
#
# The intended business number is +91 8699142699. Meta assigns the identifiers
# below when that number is onboarded - they cannot be derived from the number
# itself, so they must be supplied.
#
#   Meta Business Manager -> WhatsApp Manager -> Phone numbers -> select the
#   number -> API Setup. There you will find the Phone Number ID, and a token
#   can be generated or a permanent (System User) token obtained.
#
#   WHATSAPP_ACCESS_TOKEN        [FROM META]  System User / permanent token
#   WHATSAPP_PHONE_NUMBER_ID     [FROM META]  not the business phone number
#   WHATSAPP_BUSINESS_ACCOUNT_ID [FROM META]  WhatsApp Business Account (WABA) id
#   WHATSAPP_OTP_TEMPLATE_NAME   [FROM META]  approved AUTHENTICATION template
#   WHATSAPP_OTP_PEPPER          [GENERATED]  openssl rand -hex 32
#
# Master switch. When false the endpoints report the service as unavailable and
# the app falls back to the existing SMS/Firebase login - nothing breaks.
WHATSAPP_ENABLED=false

# --- Meta credentials [FROM META] ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v23.0

# --- Approved authentication template [FROM META] ---
# Must be an AUTHENTICATION-category template containing a single {{1}}
# parameter for the code. See docs/WHATSAPP_OTP.md for the exact setup.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_LANGUAGE_CODE=en

# --- HMAC pepper for hashing OTPs [GENERATED BY YOU] ---
# Rotating this invalidates every in-flight code (they become unverifiable);
# it is safe to rotate while no codes are outstanding.
WHATSAPP_OTP_PEPPER=

# --- OTP policy (shared with the SMS flow) ---
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# --- Abuse protection ---
OTP_PER_PHONE_HOURLY_LIMIT=5
OTP_PER_IP_HOURLY_LIMIT=30
WHATSAPP_RATE_WINDOW_MINUTES=15
WHATSAPP_RATE_MAX_REQUESTS=30

# --- Development only ---
# Returns the code in the send-otp response so automated tests can complete a
# verification without a real WhatsApp account, and skips the Meta call entirely.
# REFUSED automatically when NODE_ENV=production.
WHATSAPP_TEST_MODE=false

# Firebase Admin SDK service account JSON, kept as a single environment variable.
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}
# ===========================================================================
# capcom6 / SMS Gateway for Android  (alternative to the pull-based gateway)
# ===========================================================================
# Install the app from its releases onto the SIM phone; no build step required.
# In the app: Settings -> Server -> enable the local server, note username and
# password, and set the LAN address below to the phone.
#
# NOTE: unlike OTP_PROVIDER=gateway, this app runs an HTTP SERVER and the
# backend connects TO it. Backend and phone must share a network. No public IP
# or port forwarding is needed.
CAPCOM6_ENABLED=false
# Emulator reaches the host at 10.0.2.2; a real handset uses its LAN address.
# ===========================================================================
# capcom6 / SMS Gateway for Android  (sends the Admin Panel OTP)
# ===========================================================================
# Install the app from its releases onto the SIM phone; no build step required.
# In the app: Settings -> Server -> enable the local server, note username and
# password, and set the LAN address below to the phone.
#
# NOTE: unlike OTP_PROVIDER=gateway, this app runs an HTTP SERVER and the
# backend connects TO it. Backend and phone must share a network. No public IP
# or port forwarding is needed.
#
# API used (from the project's published docs, docs.sms-gate.app):
#   POST {SMS_GATEWAY_URL}/3rdparty/v1/messages
#        { "textMessage": { "text": "..." }, "phoneNumbers": ["+918699142699"] }
#   authenticated with HTTP Basic (SMS_GATEWAY_USERNAME / SMS_GATEWAY_PASSWORD).
#
# CAPCOM6_* remain supported as aliases so existing deployments keep working;
# the SMS_GATEWAY_* names above take precedence.
CAPCOM6_ENABLED=false

# Base URL of the app's HTTP server on the phone.
# Emulator reaches the host at 10.0.2.2; a real handset uses its LAN address.
SMS_GATEWAY_URL=http://10.0.2.2:8080
# Basic-auth credentials, exactly as set inside the SMS Gateway app.
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
# Optional device id, for accounts with more than one phone enrolled.
SMS_GATEWAY_DEVICE_ID=
SMS_GATEWAY_SIM_NUMBER=1
SMS_GATEWAY_TIMEOUT_MS=10000

# Legacy aliases (leave unset to use the names above).
# CAPCOM6_BASE_URL=
# CAPCOM6_USERNAME=
# CAPCOM6_PASSWORD=

# Delivery receipts. The signing key is shown in the app under
# Settings -> Webhooks -> Signing Key.
CAPCOM6_WEBHOOK_SECRET=
CAPCOM6_WEBHOOK_URL=
CAPCOM6_WEBHOOK_ID=rozgarmitra-otp
CAPCOM6_TIMEOUT_MS=10000

