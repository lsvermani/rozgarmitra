# Dependencies
**/node_modules/
**/.dart_tool/
**/.packages

# Local environment and secrets
**/.env
**/.env.*
!**/.env.example

# Generated builds and tooling
**/dist/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.idea/
**/.vscode/

# Local run logs (scripts\dev-up.ps1 writes here)
logs/
# Ad-hoc server logs (e.g. `npm start > server.log`)
*.log
# Signed release bundles copied out of the build folder
release-artifacts/
# Fallback MongoDB data dir used by scripts\start-mongodb.ps1
.mongo-data/
