<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch (splash) screen shown while the Flutter engine boots.
     Brand teal + the RozgarMitra magnifier glyph, then Flutter's own
     SplashScreen (/ -> splash_screen.dart) takes over. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_primary" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
