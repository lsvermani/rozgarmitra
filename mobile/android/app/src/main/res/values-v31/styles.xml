<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) system splash screen: brand background + app icon, so
     the very first frame the user sees matches the RozgarMitra palette instead
     of the default white window. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/brand_primary</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
