<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds only: allow plain-HTTP calls to the local dev API
         (http://10.0.2.2:5000/api from the Android emulator, or this machine's
         LAN IP from a physical device). Release builds keep Android's default,
         which blocks cleartext HTTP. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
